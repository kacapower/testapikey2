# GitHub token (optional) — unauthenticated requests are limited to 10 searches/min
# and 60 core requests/hour. Set it from a classic "repo" PAT for 30 searches/min
# and 5,000 requests/hour. https://github.com/settings/tokens
GITHUB_TOKEN=

# How many top repos to fetch and rank per search
MAX_REPOS=20

# How many recent pull requests to inspect per repo for review activity
MAX_PRS=50

PORT=3000