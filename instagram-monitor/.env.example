# Copy to .env (or set as environment variables on your host).
# All values except APIFY_TOKEN are optional.

# Port the web server listens on (Render/Railway/Fly set this for you).
PORT=3000

# Secret used to sign login cookies. Use a long random string.
SECRET=change-me-to-a-long-random-string

# Token that the external hourly cron (GitHub Actions) uses to trigger polls.
# Keep this secret; anyone with it can force a poll.
POLL_TOKEN=change-me-poll-token

# Your Apify API token (required). Get it at https://console.apify.com/account#/integrations
APIFY_TOKEN=

# Apify actor that scrapes an Instagram profile.
# The official apify/instagram-scraper works without login for public profiles
# and returns the profile card (avatar, bio, counts) for private accounts.
# Free plan: ~300 results/month included; after that it's ~$2.70 per 1000.
APIFY_ACTOR=apify/instagram-scraper

# How often to poll, in hours.
POLL_INTERVAL_HOURS=1

# Private accounts are checked every hour with a lightweight privacy-only ping
# (one batched run covers all private accounts, so it stays cheap). The full
# poll — avatar download, compare, save, notify — runs every POLL_BATCH_HOURS.
# If a private account goes public, it is pulled immediately and you are told
# on Telegram (no manual setup per account).
POLL_BATCH_HOURS=8

# Apify actor that saves stories + highlights.
# oneary/instagram-stories-and-highlights-scraper returns the current active
# stories and permanent highlights. Leave empty to disable story tracking.
APIFY_STORIES_ACTOR=oneary/instagram-stories-and-highlights-scraper

# Proxy group the stories actor should use. Instagram blocks the default proxy,
# so this needs RESIDENTIAL (pay-per-GB, ~$0.45/GB on Apify).
APIFY_STORIES_PROXY=RESIDENTIAL

# Hugging Face: pushes each person's data to a dataset as <user>/ folders.
# Leave empty to disable HF sync.
HF_TOKEN=
HF_DATASET=

# Telegram alerts + daily summary. TELEGRAM_USER_IDS is a comma-separated list.
# Leave empty to disable alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_IDS=

# Render API token (https://dashboard.render.com/u/settings#api-keys).
# Used for Render platform automation. Leave empty to disable.
RENDER_API_KEY=

# Data retention: media files (posts/stories) older than this many days are
# deleted to save storage. Avatars and JSON history are always kept.
RETENTION_DAYS=7

# Hour (0-23, server time) at which the daily Telegram summary is sent.
SUMMARY_HOUR=9
