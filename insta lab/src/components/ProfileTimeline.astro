---
interface Props {
  username: string;
  snapshots: any[];
  status: any;
  mediaUrl: (username: string, file: string) => string;
}

const { username, snapshots, status, mediaUrl } = Astro.props;

const fmtTime = (iso: string) => {
  if (!iso) return 'never';
  const d = new Date(iso);
  return d.toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
};

const fieldLabel = (field: string) => {
  const labels: Record<string, string> = {
    fullName: 'Display name',
    biography: 'Bio',
    followersCount: 'Followers',
    followingCount: 'Following',
    postsCount: 'Post count',
    externalUrl: 'Website',
    isPrivate: 'Private',
    profilePic: 'Profile picture',
  };
  return labels[field] || field;
};
---

<div class="relative space-y-6 pl-6 border-l border-hairline">
  {snapshots.map((snap) => (
    <div class="relative animate-fade-in" key={snap.at}>
      <span class="absolute -left-[31px] top-1 h-3 w-3 rounded-full border-2 border-primary bg-canvas"></span>
      <div class="card">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
          <div class="flex items-center gap-2">
            <span class="font-semibold text-ink">{fmtTime(snap.at)}</span>
            {snap.profile.isPrivate && <span class="badge badge-pill">private · avatar only</span>}
          </div>
          {snap.changeCount > 0
            ? <span class="badge badge-error">{snap.changeCount} change{snap.changeCount === 1 ? '' : 's'}</span>
            : <span class="badge badge-success">No changes</span>}
        </div>
        {snap.changeCount > 0 && (
          <div class="flex flex-col gap-4">
            {snap.changes.map((c: any) => {
              if (c.type === 'avatar') {
                return (
                  <div class="flex items-center gap-4">
                    <div class="flex items-center gap-2">
                      {c.from && <img class="h-14 w-14 rounded-full border border-hairline object-cover" src={mediaUrl(username, c.from)} alt="old avatar" />}
                      <span class="text-muted">→</span>
                      {c.to && <img class="h-14 w-14 rounded-full border border-hairline object-cover" src={mediaUrl(username, c.to)} alt="new avatar" />}
                    </div>
                    <div class="text-sm font-semibold text-ink">{fieldLabel(c.field)} changed</div>
                  </div>
                );
              }
              if (c.type === 'field') {
                const before = c.from ? <span>{c.from}</span> : <span class="text-muted-soft">—</span>;
                const after = c.to ? <span class="font-semibold text-semantic-error">{c.to}</span> : <span class="text-semantic-error">removed</span>;
                return (
                  <div class="text-sm">
                    <div class="font-semibold mb-1 text-ink">{fieldLabel(c.field)} changed</div>
                    <div class="flex flex-col gap-1 text-body">
                      <div class="flex gap-2"><span class="text-muted-soft shrink-0">before</span>{before}</div>
                      <div class="flex gap-2"><span class="text-semantic-error shrink-0 font-semibold">after</span>{after}</div>
                    </div>
                  </div>
                );
              }
              if (c.type === 'post') {
                const info = c.to || {};
                const img = info.mediaFile ? <img class="w-full rounded-xl border border-hairline object-cover" src={mediaUrl(username, info.mediaFile)} alt="new post" /> : '';
                const permalink = info.shortcode ? `https://www.instagram.com/p/${info.shortcode}/` : null;
                const caption = info.caption ? <p class="mt-2 text-sm text-body line-clamp-3">{info.caption}</p> : '';
                const time = info.timestamp ? <span class="text-xs text-muted">{fmtTime(info.timestamp)}</span> : '';
                return (
                  <div>
                    <div class="flex items-center gap-2 mb-2">
                      <span class="badge badge-info">New post</span>
                      {time}
                    </div>
                    {img}
                    {caption}
                    <div class="mt-2 flex items-center gap-4 text-xs font-semibold text-muted">
                      <span>Likes {info.likesCount ?? '—'}</span>
                      <span>Comments {info.commentsCount ?? '—'}</span>
                      {permalink && <a class="text-text-link underline" href={permalink} target="_blank" rel="noopener">view on Instagram</a>}
                    </div>
                  </div>
                );
              }
              if (c.type === 'story') {
                return <div class="text-sm font-semibold text-ink">A new story was saved{c.to?.highlightTitle ? ` to highlight "${c.to.highlightTitle}"` : ''} (uploaded {fmtTime(c.to?.timestamp)})</div>;
              }
              if (c.type === 'removed') {
                return <div class="text-sm font-semibold text-ink">A post was removed{c.from && <span class="text-semantic-error"> ({c.from})</span>}</div>;
              }
              return <div class="text-sm text-body">Unknown change</div>;
            })}
          </div>
        )}
        {(snap.stories || []).length > 0 && (
          <div>
            <div class="flex items-center gap-2 mb-2">
              <span class="badge chip-story">New stories saved</span>
              <span class="text-xs text-muted">{snap.stories.length} saved</span>
            </div>
            <div class="grid grid-cols-3 sm:grid-cols-4 gap-2">
              {snap.stories.map((s: any) => (
                <div class="relative" key={s.mediaFile || Math.random()}>
                  {s.mediaFile && <img class="aspect-square w-full rounded-lg object-cover border border-hairline" src={mediaUrl(username, s.mediaFile)} alt="story" />}
                  {s.isHighlight && <span class="absolute bottom-1 left-1 text-[10px] font-bold bg-black/60 text-white rounded-full px-2 py-0.5">HL</span>}
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  ))}
</div>