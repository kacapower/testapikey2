---
interface Props {
  profiles: any[];
  historyData: any;
  status: any;
  mediaUrl: (username: string, file: string) => string;
  window: string;
  sort: { key: string; dir: number };
}

const { profiles, historyData, status, mediaUrl, window: lbWindow, sort } = Astro.props;

const DRIVER_COLORS = ['#e10600', '#ff8700', '#00d2be', '#005aff', '#f9006d', '#1e41ff', '#00f5d0', '#ff2ed1', '#50c878', '#7cb342', '#e4e4e4', '#4e9a51'];

const fmtTime = (iso: string) => {
  if (!iso) return 'never';
  const d = new Date(iso);
  return d.toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
};

const now = Date.now();
const cutoff = lbWindow === 'all' ? null : now - Number(lbWindow) * 86400000;

const rows = profiles.map((p, idx) => {
  const snaps = ((historyData?.profiles || {})[p.username] || []).filter((s: any) => !cutoff || Date.parse(s.at) >= cutoff);
  let changes = 0;
  let posts = 0;
  let stories = 0;
  let avatars = 0;
  for (const s of snaps) {
    changes += s.changeCount || 0;
    for (const c of s.changes || []) {
      if (c.type === 'post') posts += 1;
      else if (c.type === 'story') stories += 1;
      else if (c.type === 'avatar') avatars += 1;
    }
  }
  let followers: number | null = null;
  if (snaps.length >= 2) {
    const first = snaps[0].profile?.followersCount;
    const last = snaps[snaps.length - 1].profile?.followersCount;
    if (typeof first === 'number' && typeof last === 'number') followers = last - first;
  }
  return { 
    username: p.username, 
    isPrivate: p.isPrivate, 
    changes, 
    posts, 
    stories, 
    avatars, 
    followers, 
    snapCount: snaps.length,
    accent: DRIVER_COLORS[idx % DRIVER_COLORS.length]
  };
});

const { key, dir } = sort;
rows.sort((a, b) => {
  const av = a[key] ?? -Infinity;
  const bv = b[key] ?? -Infinity;
  return (av < bv ? -1 : av > bv ? 1 : 0) * dir;
});

const posBadge = (pos: number) => {
  if (pos === 1) return '<span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-amber-500 font-bold text-neutral-900">P1</span>';
  if (pos === 2) return '<span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-zinc-400 font-bold text-neutral-900">P2</span>';
  if (pos === 3) return '<span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-amber-700 font-bold text-white">P3</span>';
  return `<span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-surface-strong font-bold text-muted">${pos}</span>`;
};

const followerCell = (value: number | null) => {
  if (value === null || value === undefined) return '<span class="text-muted-soft">—</span>';
  if (value === 0) return '<span class="text-muted">0</span>';
  const sign = value > 0 ? '+' : '';
  return `<span class="font-bold tabular-nums ${value > 0 ? 'text-semantic-success' : 'text-semantic-error'}">${sign}${value.toLocaleString()}</span>`;
};

const avatarInitial = (u: string) => (u || '?').charAt(0).toUpperCase();
---

<div class="overflow-x-auto">
  <table class="w-full text-sm" role="table">
    <thead>
      <tr class="border-b border-hairline">
        <th class="text-left py-2 pr-3 text-xs font-semibold text-muted uppercase tracking-wide w-14" scope="col">Pos</th>
        <th class="text-left py-2 pr-3 text-xs font-semibold text-muted uppercase tracking-wide" scope="col">Profile</th>
        <th class="text-right py-2 px-2 text-xs font-semibold text-muted uppercase tracking-wide" scope="col">Trend</th>
        <th class="text-right py-2 px-2">
          <button class="lb-sort font-semibold text-body text-xs uppercase tracking-wide hover:text-ink transition-colors {sort.key === 'changes' ? 'text-ink' : ''}" data-key="changes" aria-sort={sort.key === 'changes' ? (sort.dir === -1 ? 'descending' : 'ascending') : 'none'}>
            Changes{sort.key === 'changes' ? (sort.dir === -1 ? ' ▼' : ' ▲') : ''}
          </button>
        </th>
        <th class="text-right py-2 px-2">
          <button class="lb-sort font-semibold text-body text-xs uppercase tracking-wide hover:text-ink transition-colors {sort.key === 'posts' ? 'text-ink' : ''}" data-key="posts" aria-sort={sort.key === 'posts' ? (sort.dir === -1 ? 'descending' : 'ascending') : 'none'}>
            New posts{sort.key === 'posts' ? (sort.dir === -1 ? ' ▼' : ' ▲') : ''}
          </button>
        </th>
        <th class="text-right py-2 px-2">
          <button class="lb-sort font-semibold text-body text-xs uppercase tracking-wide hover:text-ink transition-colors {sort.key === 'stories' ? 'text-ink' : ''}" data-key="stories" aria-sort={sort.key === 'stories' ? (sort.dir === -1 ? 'descending' : 'ascending') : 'none'}>
            Stories{sort.key === 'stories' ? (sort.dir === -1 ? ' ▼' : ' ▲') : ''}
          </button>
        </th>
        <th class="text-right py-2 px-2">
          <button class="lb-sort font-semibold text-body text-xs uppercase tracking-wide hover:text-ink transition-colors {sort.key === 'avatars' ? 'text-ink' : ''}" data-key="avatars" aria-sort={sort.key === 'avatars' ? (sort.dir === -1 ? 'descending' : 'ascending') : 'none'}>
            Avatars{sort.key === 'avatars' ? (sort.dir === -1 ? ' ▼' : ' ▲') : ''}
          </button>
        </th>
        <th class="text-right py-2 px-2">
          <button class="lb-sort font-semibold text-body text-xs uppercase tracking-wide hover:text-ink transition-colors {sort.key === 'followers' ? 'text-ink' : ''}" data-key="followers" aria-sort={sort.key === 'followers' ? (sort.dir === -1 ? 'descending' : 'ascending') : 'none'}>
            Followers Δ{sort.key === 'followers' ? (sort.dir === -1 ? ' ▼' : ' ▲') : ''}
          </button>
        </th>
      </tr>
    </thead>
    <tbody>
      {rows.map((r, i) => (
        <tr class="border-b border-hairline-soft last:border-0">
          <td class="py-3 pr-3">{posBadge(i + 1)}</td>
          <td class="py-3 pr-3">
            <div class="flex items-center gap-3">
              <span class="inline-block h-2.5 w-2.5 rounded-full shrink-0" style={`background: ${r.accent}`}></span>
              {!r.isPrivate && (
                <div class="relative">
                  {(() => {
                    const avatar = ((historyData?.profiles || {})[r.username] || []).slice(-1)[0]?.profile?.profilePicFile;
                    return avatar 
                      ? <img class="h-8 w-8 rounded-full border border-hairline object-cover" src={mediaUrl(r.username, avatar)} alt="" />
                      : <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-surface-strong font-bold text-muted">{avatarInitial(r.username)}</span>;
                  })()}
                </div>
              )}
              <div class="min-w-0">
                <div class="font-semibold truncate text-ink">@{r.username}{r.isPrivate && <span class="text-muted">· private</span>}</div>
                <div class="text-[10px] text-muted">{r.snapCount} snapshot{r.snapCount === 1 ? '' : 's'}</div>
              </div>
            </div>
          </td>
          <td class="py-3 px-2"><canvas data-spark={r.username} class="w-full h-9"></canvas></td>
          <td class="py-3 px-2 text-right font-bold tabular-nums text-ink">{r.changes}</td>
          <td class="py-3 px-2 text-right tabular-nums text-body">{r.posts}</td>
          <td class="py-3 px-2 text-right tabular-nums text-body">{r.stories}</td>
          <td class="py-3 px-2 text-right tabular-nums text-body">{r.avatars}</td>
          <td class="py-3 px-2 text-right">{followerCell(r.followers)}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<script>
  // Sparklines will be drawn by client-side script
</script>