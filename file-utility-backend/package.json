{
  "name": "render-file-utility-backend",
  "version": "1.0.0",
  "description": "Production-ready, memory-capped image compressor and PDF-to-image converter API with in-memory FIFO queue for Render Free Tier.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --max-old-space-size=384 src/server.js",
